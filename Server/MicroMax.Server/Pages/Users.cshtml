@page
@model MicroMax.Server.Pages.UsersModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Пользователи";
}

<section class="page-heading">
    <div>
        <p class="page-eyebrow">Доступ и роли</p>
        <h1>Пользователи</h1>
        <p>
            Раздел предназначен для просмотра пользователей, редактирования основных данных и управления
            ролями по складам. Назначения отображаются только для складов, которыми управляет текущий администратор.
        </p>
    </div>
    <div class="page-heading__actions">
        <span class="badge badge--warning">Временный пароль для новых пользователей: @Model.DefaultPasswordHint</span>
    </div>
</section>

<partial name="_AdminAlerts" />

<div class="grid grid--two">
    <section class="panel">
        <div class="panel__header">
            <div>
                <h2>Новый пользователь</h2>
                <p class="panel__intro">Создаётся активная учётная запись с временным паролем.</p>
            </div>
        </div>
        <form method="post" asp-page-handler="Create" class="stack">
            <label>Email
                <input asp-for="CreateForm.Email" type="email" placeholder="user@micromax.local" />
            </label>
            <label>Имя пользователя
                <input asp-for="CreateForm.DisplayName" placeholder="Например, Иван Петров" />
            </label>
            <button type="submit">Создать пользователя</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel__header">
            <div>
                <h2>Редактирование пользователя</h2>
                <p class="panel__intro">Выберите пользователя в таблице, чтобы изменить его имя и email.</p>
            </div>
        </div>
        @if (Model.SelectedUser is null)
        {
            <div class="empty-state">Сначала выберите пользователя в таблице ниже.</div>
        }
        else
        {
            <form method="post" asp-page-handler="Update" class="stack">
                <input asp-for="EditForm.Id" type="hidden" />
                <label>Email
                    <input asp-for="EditForm.Email" type="email" />
                </label>
                <label>Имя пользователя
                    <input asp-for="EditForm.DisplayName" />
                </label>
                <div class="row-actions">
                    <button type="submit">Сохранить изменения</button>
                    @if (Model.SelectedUser.IsActive)
                    {
                        <span class="badge badge--success">Активен</span>
                    }
                    else
                    {
                        <span class="badge badge--danger">Отключён</span>
                    }
                </div>
            </form>
        }
    </section>
</div>

<section class="panel">
    <div class="panel__header">
        <div>
            <h2>Список пользователей</h2>
            <p class="panel__intro">Таблица показывает количество назначений пользователя в управляемых складах.</p>
        </div>
    </div>

    @if (Model.Users.Count == 0)
    {
        <div class="empty-state">Пользователи пока не созданы.</div>
    }
    else
    {
        <div class="table-wrapper">
            <table>
                <thead>
                <tr>
                    <th>Пользователь</th>
                    <th>Email</th>
                    <th>Статус</th>
                    <th>Назначения в управляемых складах</th>
                    <th>ADMIN в управляемых складах</th>
                    <th>Действия</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Users)
                {
                    <tr>
                        <td>@row.DisplayName</td>
                        <td>@row.Email</td>
                        <td>
                            @if (row.IsActive)
                            {
                                <span class="badge badge--success">Активен</span>
                            }
                            else
                            {
                                <span class="badge badge--danger">Отключён</span>
                            }
                        </td>
                        <td>@row.ManagedAssignmentCount</td>
                        <td>
                            @if (row.HasAdminAssignment)
                            {
                                <span class="badge badge--warning">Да</span>
                            }
                            else
                            {
                                <span class="badge badge--muted">Нет</span>
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                <a class="button-link button-secondary" asp-page="/Users" asp-route-selectedUserId="@row.Id">Открыть</a>
                                <form method="post" asp-page-handler="ToggleActive" class="inline-form">
                                    <input type="hidden" name="userId" value="@row.Id" />
                                    <button type="submit" class="button-ghost">@(row.IsActive ? "Отключить" : "Активировать")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <div class="panel__header">
        <div>
            <h2>Назначения по складам</h2>
            <p class="panel__intro">Связка «Пользователь - Склад - Роль» управляет доступом к складам и админ-панели.</p>
        </div>
    </div>

    @if (Model.SelectedUser is null)
    {
        <div class="empty-state">Выберите пользователя, чтобы назначать роли по складам.</div>
    }
    else
    {
        <div class="grid grid--two">
            <section class="panel">
                <div class="panel__header">
                    <div>
                        <h3>Новое назначение</h3>
                        <p class="panel__intro">@Model.SelectedUser.DisplayName</p>
                    </div>
                </div>
                <form method="post" asp-page-handler="AssignWarehouse" class="stack">
                    <input asp-for="AssignmentForm.UserId" type="hidden" value="@Model.SelectedUser.Id" />
                    <label>Склад
                        <select asp-for="AssignmentForm.WarehouseId" asp-items="@(new SelectList(Model.Warehouses, "Id", "Name"))"></select>
                    </label>
                    <label>Роль
                        <select asp-for="AssignmentForm.RoleId" asp-items="@(new SelectList(Model.Roles, "Id", "Name"))"></select>
                    </label>
                    <button type="submit">Назначить роль</button>
                </form>
            </section>

            <section class="panel">
                <div class="panel__header">
                    <div>
                        <h3>Активные назначения</h3>
                        <p class="panel__intro">Отображаются только склады, доступные текущему администратору.</p>
                    </div>
                </div>

                @if (Model.Assignments.Count == 0)
                {
                    <div class="empty-state">В управляемых складах у пользователя пока нет назначений.</div>
                }
                else
                {
                    <div class="table-wrapper">
                        <table>
                            <thead>
                            <tr>
                                <th>Склад</th>
                                <th>Роль</th>
                                <th>Назначено</th>
                                <th>Изменение</th>
                                <th>Удаление</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in Model.Assignments)
                            {
                                <tr>
                                    <td>@row.WarehouseName</td>
                                    <td>
                                        @row.RoleName
                                        <div class="subtle">@row.RoleCode</div>
                                    </td>
                                    <td>@row.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <form method="post" asp-page-handler="ChangeRole" class="inline-form">
                                            <input type="hidden" name="userId" value="@row.UserId" />
                                            <input type="hidden" name="warehouseId" value="@row.WarehouseId" />
                                            <select name="roleId" asp-items="@(new SelectList(Model.Roles, "Id", "Name", row.RoleId))"></select>
                                            <button type="submit" class="button-secondary">Сменить роль</button>
                                        </form>
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="RemoveAssignment" class="inline-form">
                                            <input type="hidden" name="userId" value="@row.UserId" />
                                            <input type="hidden" name="warehouseId" value="@row.WarehouseId" />
                                            <button type="submit" class="button-danger">Удалить</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    }
</section>
